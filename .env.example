# BuildScope environment variables.
# Copy to `.env` (never commit `.env`). docker-compose and the API both read it.
# The web app reads `apps/web/.env.local` when run outside Docker (defaults work locally).

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=buildscope
POSTGRES_PASSWORD=buildscope
POSTGRES_DB=buildscope
POSTGRES_PORT=5432

# --- API (apps/api) ---
# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = one JSON object per line; false = human-readable lines
LOG_JSON=false
# Must use the async driver scheme. docker-compose overrides the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://buildscope:buildscope@localhost:5432/buildscope
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Auth: the API verifies JWTs issued by Better Auth (apps/web) using its public keys (JWKS).
# docker-compose overrides AUTH_JWKS_URL to reach the web container.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Must equal BETTER_AUTH_URL below.
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=buildscope-api
AUTH_JWKS_TIMEOUT_SECONDS=5
# Test database used by `make test-api` (created and migrated automatically).
TEST_DATABASE_URL=postgresql+asyncpg://buildscope:buildscope@localhost:5432/buildscope_test
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
API_PORT=8000

# --- Web (apps/web) — server-side only, never exposed to the browser ---
# URL the Next.js server uses to reach the API. docker-compose sets http://api:8000.
API_INTERNAL_URL=http://localhost:8000
API_TIMEOUT_MS=3000
WEB_PORT=3000

# --- Auth (Better Auth, runs in apps/web) — server-side only ---
# Public URL of the web app. Also the JWT issuer (keep AUTH_JWT_ISSUER in sync).
BETTER_AUTH_URL=http://localhost:3000
# REQUIRED. Random string, at least 32 characters. Generate with: openssl rand -base64 32
# Encrypts signing keys and signs cookies; rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Same database as the API, with the plain postgresql:// scheme (node-postgres).
AUTH_DATABASE_URL=postgresql://buildscope:buildscope@localhost:5432/buildscope
